<model>
    <mount>//OPNsense/Vpnlink</mount>
    <version>3.1.0</version>
    <description>VPN Traffic Orchestrator</description>

    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
        </general>

        <!-- Each link: WG source → LAN to mirror -->
        <links>
            <link type="ArrayField">
                <enabled type="BooleanField">
                    <default>1</default>
                    <Required>Y</Required>
                </enabled>

                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[a-zA-Z0-9_ \-]{1,64}$/</Mask>
                    <ValidationMessage>Name for this link</ValidationMessage>
                </name>

                <source type="TextField">
                    <Required>Y</Required>
                    <Mask>/^(any|(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])(\.(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])){3}(\/(3[0-2]|[12]?[0-9]))?)( *, *(any|(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])(\.(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])){3}(\/(3[0-2]|[12]?[0-9]))?))*$/</Mask>
                    <ValidationMessage>WireGuard source(s): "any", or comma-separated IPs/subnets</ValidationMessage>
                </source>

                <lanInterface type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[a-zA-Z0-9_]{1,32}$/</Mask>
                    <ValidationMessage>LAN interface to mirror (e.g. opt1)</ValidationMessage>
                </lanInterface>

                <cloneRules type="BooleanField">
                    <default>1</default>
                    <Required>Y</Required>
                </cloneRules>

                <autoNat type="BooleanField">
                    <default>1</default>
                    <Required>Y</Required>
                </autoNat>

                <dnsSync type="BooleanField">
                    <default>1</default>
                    <Required>Y</Required>
                </dnsSync>

                <!-- Optional egress override: send this source's internet traffic via a gateway -->
                <gateway type="TextField">
                    <Mask>/^[a-zA-Z0-9_\-\.]{0,64}$/</Mask>
                    <ValidationMessage>Gateway name (letters, digits, _ - .)</ValidationMessage>
                </gateway>

                <!-- Never let this source leave directly via WAN (e.g. when the VPN gateway is down) -->
                <killSwitch type="BooleanField">
                    <default>0</default>
                    <Required>Y</Required>
                </killSwitch>

                <!-- Outbound NAT on the mirrored LAN itself (hides VPN client IPs from LAN hosts) -->
                <natOnLan type="BooleanField">
                    <default>1</default>
                    <Required>Y</Required>
                </natOnLan>
            </link>
        </links>
    </items>
</model>
